# ============================================================================
# Challenge data -- organiser-supplied, up to 509 MB per file
# ============================================================================
dataset/

# ============================================================================
# work/ and output/ are ALLOWLISTS: everything generated is ignored except the
# final model artefacts and the final submission. Regenerate the rest with the
# commands in PIPELINE_README.md (PYTHONHASHSEED=0, frozen SEED=20260925).
# Bulk artefacts here reach 7+ GB each (embeddings, feature caches, candidates).
# ============================================================================
work/*
!work/matcher_lgb.txt
!work/matcher_calib.pkl
!work/best_rule.npy

output/*
!output/matching_results.tsv

